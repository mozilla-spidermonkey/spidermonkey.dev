
          import mod0 from "src/js.wasm.core.wasm"
import mod1 from "src/js.wasm.core2.wasm"
import mod2 from "src/js.wasm.core3.wasm"
import mod3 from "src/js.wasm.core4.wasm"

          const modulePaths = new Map();
          modulePaths.set("src/js.wasm.core.wasm", mod0);
modulePaths.set("src/js.wasm.core2.wasm", mod1);
modulePaths.set("src/js.wasm.core3.wasm", mod2);
modulePaths.set("src/js.wasm.core4.wasm", mod3);
          export function loader(path) {
            return WebAssembly.compileStreaming(fetch("/assets/js/iongraph/" + modulePaths.get(path)));
